# ── Discord bot ──────────────────────────────────────────────────────────────
# Bot token (required for the Discord bot to start).
DISCORD_TOKEN=
# Channel the preview-ready notifications are posted to. Default is the MAIN
# bot's channel — the dev bot MUST override this or it posts dev previews to
# production.
#   dev: DISCORD_NOTIFY_CHANNEL_ID=<dev channel id>
DISCORD_NOTIFY_CHANNEL_ID=1530270176199839864
# Ingestion reaction emoji. Custom emoji use the reaction form "name:id" — no
# angle brackets. Defaults are the MAIN bot's; the dev bot must override the
# success one (its emoji is a different application-owned emoji).
#   dev: DISCORD_EMOJI_SUCCESS=goyangi_success:1530513142629531739
# Reacted on any run that ingested something, whether or not every item made it.
DISCORD_EMOJI_SUCCESS=goyangi_success:1530520100409573447
# INERT — nothing reacts with these any more. A partial or failed run is a
# system_logs entry for whoever runs the bot; marking the poster's message reads
# as a public correction. Kept so the names don't look merely forgotten.
DISCORD_EMOJI_WARNING=⚠️
DISCORD_EMOJI_FAILURE=❌
# Marks a message deliberately NOT ingested (role ping + bot @-mention together).
DISCORD_EMOJI_SKIPPED=⏭️

# Roles allowed to run the ingestion paths that ignore the channel allowlist:
# /reupload and the "Ingest this message" context menu. EMPTY DISABLES THE ROLE
# CHECK, leaving only the commands' Manage Messages permission hint, which some
# clients ignore. Set this in prod.
# The older DISCORD_REUPLOAD_ROLE_IDS is still read when this is unset.
DISCORD_INGEST_ROLE_IDS=
# Comma-separated channels where the PASSIVE triggers (role ping, reply, bare
# follow-up, text detection) are allowed. The context menu and /reupload are not
# confined to these — they are explicit actions on a named message.
DISCORD_ALLOWED_CHANNEL_IDS=1170388502379249747
# Channel site uploads are announced in. Default is the MAIN bot's channel —
# the dev bot MUST override this or it posts dev uploads to production.
#   dev: DISCORD_POST_CHANNEL_ID=1530276704801656954
DISCORD_POST_CHANNEL_ID=1530277196453773312
# Guild whose roles the automatic upload pings resolve against.
DISCORD_GUILD_ID=1530268583983186031

# Imgur API client id, used to resolve album/gallery links into their items.
# Unset means imgur's own web client id (registration is closed, so there is no
# other way to get one); "off" disables the API path, leaving the page's
# OpenGraph tags, which imgur stopped serving in 2026 — i.e. albums ingest
# nothing.
IMGUR_CLIENT_ID=

# Names the free-text idol detector must ignore (comma-separated,
# case-insensitive). For directory entries whose name is also an ordinary word —
# an idol called "Ian" or "Liz" would otherwise match any message using it.
GOYANGI_DETECT_STOPWORDS=

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public site base URL used to build shareable content links.
GOYANGI_PUBLIC_URL=https://goyangi.pics
# Contact surfaced by /privacy for deletion and ingestion opt-out requests.
# Keep in sync with the frontend's NUXT_PUBLIC_SUPPORT_EMAIL.
GOYANGI_SUPPORT_EMAIL=goyangi.pics@protonmail.com

# ── Retention ────────────────────────────────────────────────────────────────
# Days of system_logs kept by the daily retention cron (default 90; zero,
# negative or unparsable values fall back to the default). The privacy policy
# states this number — change both together.
GOYANGI_LOG_RETENTION_DAYS=

# ── R2 / media pipeline ──────────────────────────────────────────────────────
# Public base URL of the R2 bucket (required — server refuses to boot without it).
R2_PUBLIC_URL=https://cdn.goyangi.pics
# Max concurrent transcode jobs (default 1).
MAX_PROCESS_JOBS=1
# Max concurrent R2 object deletes within one cleanup batch (default 8).
MAX_R2_DELETE_JOBS=
# Delete R2 objects a record has stopped pointing at, after an edit/reprocess.
# On by default; set to 0 to disable.
GOYANGI_R2_UPDATE_CLEANUP=
# Use libavif's avifenc instead of ffmpeg's avif muxer ("1" to enable).
GOYANGI_USE_AVIFENC=
# Work dir for avifenc Y4M intermediates (default /tmp; set /var/tmp if /tmp is tmpfs).
GOYANGI_AVIFENC_DIR=
# Work dir for RIFE frame interpolation (default /tmp; set /var/tmp on tmpfs hosts).
GOYANGI_RIFE_DIR=
# Encoder for the H.264 `sd` fallback rendition: auto (default), vaapi, nvenc
# or cpu. auto tries VAAPI (Linux + Intel/AMD GPU), then NVENC (NVIDIA, via a
# test encode at boot), then libx264. The boot log says which one was picked.
GOYANGI_H264_ENCODER=
# DRM render node used for VAAPI. Defaults to /dev/dri/renderD128. "off" forces
# the libx264 CPU path whatever GOYANGI_H264_ENCODER says.
GOYANGI_VAAPI_DEVICE=

# NOTE: R2 bucket credentials (access key / secret / endpoint / bucket) are
# configured in PocketBase's own S3 storage settings (admin UI), not here.
#
# The one exception is scripts/backfilldiscord, which uploads to R2 from
# another machine and so needs its own copy (same values as the admin UI), plus
# a superuser for the PocketBase API. The server never reads these.
#   R2_ENDPOINT=
#   R2_BUCKET=
#   R2_ACCESS_KEY=
#   R2_SECRET_KEY=
#   R2_REGION=auto
#   PB_ADMIN_EMAIL=
#   PB_ADMIN_PASSWORD=
